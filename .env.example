# =============================================================================
# VDEAR — FILE KHAI BÁO KHOÁ/BÍ MẬT (điền giá trị THẬT của bạn rồi đổi tên file
# này thành ".env.local"). KHÔNG commit file .env.local lên Git.
# Mỗi dòng có ghi chú "→ lấy ở đâu". Chỗ nào chưa có cứ để trống, mình xử lý sau.
# =============================================================================


# ------------------------------- APP / CHUNG ---------------------------------
NEXT_PUBLIC_SITE_NAME=Vdear
NEXT_PUBLIC_SITE_URL=https://              # ← domain thật, vd https://vdear.io
NODE_ENV=production


# --------------------------------- CLERK (đăng nhập) -------------------------
# → clerk.com → tạo Application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_
# → Clerk → Webhooks → tạo endpoint .../api/webhooks/clerk → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up


# ------------------------------- SUPABASE (database) -------------------------
# → supabase.com → New project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://           # vd https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                  # ← BÍ MẬT, chỉ dùng phía server
# → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://


# --------------------------------- STRIPE (thanh toán) -----------------------
# → dashboard.stripe.com → Developers → API keys (dùng key LIVE khi chạy thật)
STRIPE_SECRET_KEY=sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
# → Developers → Webhooks → add endpoint .../api/webhooks/stripe → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_
# → Products → tạo gói Pro → copy Price ID (bắt đầu bằng price_...)
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_YEARLY=price_


# --------------------------------- RESEND (email) ----------------------------
# → resend.com → API Keys ; và Domains → verify domain (thêm bản ghi DNS ở SETUP.md)
RESEND_API_KEY=re_
EMAIL_FROM=Vdear <no-reply@>                # ← điền domain, vd no-reply@vdear.io
EMAIL_REPLY_TO=support@                     # ← vd support@vdear.io


# ------------------------------- UPSTASH (Redis cache) -----------------------
# → upstash.com → Create Database (Redis) → REST API
UPSTASH_REDIS_REST_URL=https://
UPSTASH_REDIS_REST_TOKEN=


# --------------------------------- POSTHOG (analytics) -----------------------
# → posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # hoặc eu.i.posthog.com


# ---------------------------------- SENTRY (lỗi) -----------------------------
# → sentry.io → Project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://
# → Sentry → Settings → Auth Tokens (để upload source maps khi build)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# --------------------------------- PINECONE (AI/vector) ----------------------
# → pinecone.io → API Keys ; tạo Index và điền tên + host
PINECONE_API_KEY=
PINECONE_INDEX=vdear
PINECONE_HOST=https://                      # ← host của index (trong trang Index)


# ------------------------ LLM / EMBEDDINGS (cho tính năng AI) ----------------
# Chat AI (hỏi đáp coin). Dùng Claude:
ANTHROPIC_API_KEY=sk-ant-
# Tạo embeddings để nạp vào Pinecone (chọn 1). Gợi ý: OpenAI hoặc Voyage.
OPENAI_API_KEY=sk-
# VOYAGE_API_KEY=


# ------------------------ CLOUDFLARE (tuỳ chọn — deploy/API) -----------------
# Chỉ cần nếu deploy bằng CLI/Workers. DNS thì làm trên dashboard (xem SETUP.md).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# ------------------------ NAMECHEAP (không cần key cho web) ------------------
# Domain chỉ cần trỏ nameserver về Cloudflare — không cần điền vào đây.


# ------------------------ ProductBridge (CHƯA RÕ) ---------------------------
# Bạn cho mình biết dịch vụ này để làm gì, mình sẽ bổ sung biến tương ứng.
# PRODUCTBRIDGE_API_KEY=
