# =============================================================================
# VDEAR Crypto — environment variables
# Copy to .env.local for local dev, or set in Vercel Project Settings.
#
# RULE: anything NEXT_PUBLIC_* is exposed to the browser. Everything else is
# server-only and MUST NOT be prefixed with NEXT_PUBLIC_. Never put a private
# exchange secret or a service-role key behind a NEXT_PUBLIC_ name.
# =============================================================================

# --- Public site ---
# Optional. Leave blank on Vercel: lib/site.ts falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then localhost. Set this only
# when you attach a custom domain.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (auth + watchlist/portfolio/alerts) ---
# Public (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (privileged; used by server routes/cron). KEEP SECRET:
SUPABASE_SERVICE_ROLE_KEY=

# --- Exchange PUBLIC market data needs NO keys. ---
# The connectors use public REST endpoints only. Add keys ONLY if you later
# call private/account endpoints — and only server-side. Leave blank otherwise.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- CoinGlass (server-only). Two features use it:
#     1. Liquidation views — without a key they fall back to transparent
#        exchange-derived ESTIMATES.
#     2. DÒNG TIỀN ETF (api/etf-flow.js) — without a key the ETF section shows
#        "chua cau hinh nguon" and stays empty. It never estimates.
# NOTE: the Liquidation MAP and pair HEATMAP endpoints require a CoinGlass
# PROFESSIONAL or ENTERPRISE plan. A key on a lower plan will still show the
# estimated fallback (with a message explaining why). The ETF flow-history
# endpoints, by contrast, are available on EVERY plan including Hobbyist.
COINGLASS_API_KEY=
# Exchange CoinGlass queries for map/heatmap (default Binance):
# COINGLASS_EXCHANGE=Binance
# Override only if your plan uses a different base URL:
# COINGLASS_API_BASE=https://open-api-v4.coinglass.com

# --- News (optional; server-only). Without it, /news shows "not configured". ---
NEWS_API_KEY=

# =============================================================================
# Data providers — the platform runs on the FREE ones with no keys at all.
# Premium keys are enhancements: when absent, their metrics are reported as
# "not configured" and the affected score renormalises. Nothing is estimated
# in their place.
# =============================================================================

# --- Core providers: NO KEY REQUIRED. A key only raises rate limits. ---
# CoinGecko: global market cap, dominance, ranking, category taxonomy.
COINGECKO_API_KEY=
# DeFiLlama: stablecoin supply, chain TVL, DEX volume. Pro key = higher limits.
DEFI_LLAMA_API_KEY=
# Coin Metrics: on-chain activity. Community tier is keyless and sufficient.
COINMETRICS_API_KEY=
# GeckoTerminal needs no key at all (no variable).

# --- Premium providers: OPTIONAL. Absent = feature reports "not configured". ---
GLASSNODE_API_KEY=
# GLASSNODE_API_BASE=https://api.glassnode.com/v1/metrics
CRYPTOQUANT_API_KEY=
# CRYPTOQUANT_API_BASE=https://api.cryptoquant.com/v1
ARTEMIS_API_KEY=
# Artemis' response schema could not be verified against a live call during
# development; override these if your account's schema differs.
# ARTEMIS_API_BASE=https://api.artemisxyz.com

# --- Cron (Vercel Scheduled Functions) ---
# Required for the /api/cron/* routes. Without it they refuse to run rather
# than being publicly triggerable.
CRON_SECRET=

# --- DÒNG TIỀN ETF giao ngay (api/etf-flow.js) ---
# Dòng tiền ròng của ETF tính từ số chứng chỉ quỹ phát hành thêm / mua lại
# trong ngày. KHÔNG suy ra được từ giá hay khối lượng khớp lệnh, và không có
# nguồn miễn phí nào công bố. Hàm chạy trên server; trình duyệt không thấy key.
#
# Đặt MỘT trong hai, hoặc cả hai. Có cả hai thì mỗi tài sản lấy CoinGlass
# trước (đã đối chiếu tài liệu), thiếu mới rơi xuống SoSoValue.
#
# 1) CoinGlass — dùng lại COINGLASS_API_KEY ở trên. ĐÃ ĐỐI CHIẾU TÀI LIỆU.
#    GET /api/etf/{bitcoin|ethereum|solana|xrp}/flow-history
#    Chỉ 4 tài sản, nhưng có ở mọi gói và kèm dòng tiền từng quỹ.
#
# 2) SoSoValue — phủ nhiều tài sản hơn.
SOSOVALUE_API_KEY=
# CẢNH BÁO: đường dẫn và tên trường của SoSoValue CHƯA đối chiếu được với tài
# liệu (môi trường phát triển chặn mọi host bên ngoài). Mặc định bên dưới là
# giả định, không phải sự thật đã kiểm chứng. Nếu gọi hỏng, hàm trả về ĐÚNG
# thứ nó đã gọi và các tên trường nó thấy — sửa bằng mấy biến này, không phải
# sửa code, và không phải redeploy code mới.
# SOSOVALUE_API_BASE=https://api.sosovalue.xyz
# SOSOVALUE_ETF_PATH=/openapi/v2/etf/currentEtfDataMetrics
# SOSOVALUE_ETF_METHOD=POST
# SOSOVALUE_KEY_HEADER=x-soso-api-key
# Sửa mã tài sản nếu SoSoValue dùng khuôn khác us-<symbol>-spot:
# SOSOVALUE_TYPE_MAP={"HYPE":"us-hyperliquid-spot"}
#
# Không key nào -> mục ETF hiện "chưa cấu hình nguồn" và để trống. Không bao
# giờ hiện số ước lượng.
