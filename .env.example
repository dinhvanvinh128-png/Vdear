# =============================================================================
# VDEAR Crypto — environment variables
# Copy to .env.local for local dev, or set in Vercel Project Settings.
#
# RULE: anything NEXT_PUBLIC_* is exposed to the browser. Everything else is
# server-only and MUST NOT be prefixed with NEXT_PUBLIC_. Never put a private
# exchange secret or a service-role key behind a NEXT_PUBLIC_ name.
# =============================================================================

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://vdear-crypto.vercel.app

# --- Supabase (auth + watchlist/portfolio/alerts) ---
# Public (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (privileged; used by server routes/cron). KEEP SECRET:
SUPABASE_SERVICE_ROLE_KEY=

# --- Exchange PUBLIC market data needs NO keys. ---
# The connectors use public REST endpoints only. Add keys ONLY if you later
# call private/account endpoints — and only server-side. Leave blank otherwise.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- CoinGlass (optional; server-only). Without it, liquidation views fall
#     back to transparent exchange-derived ESTIMATES. ---
COINGLASS_API_KEY=
# Override only if your plan uses a different base URL:
# COINGLASS_API_BASE=https://open-api-v4.coinglass.com

# --- News (optional; server-only). Without it, /news shows "not configured". ---
NEWS_API_KEY=
